{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "holdings.proof/mcp-server",
  "title": "Proof Holdings",
  "description": "One API, all things verified — control, delegation, human approval, anti-impersonation.",
  "version": "1.8.4",
  "websiteUrl": "https://proof.holdings",
  "icons": [
    {
      "src": "https://proof.holdings/favicon-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://proof.holdings/mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/ProofHoldings/mcp-server",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.proof.holdings/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@proof-holdings/mcp-server",
      "version": "1.8.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PROOF_API_KEY",
          "description": "Proof Holdings API key (Bearer). Optional: without it the server runs in public mode, where account creation, login and public verification tools work and every other tool asks for a key. Create one in the dashboard at https://proof.holdings. Or run `npx @proof-holdings/mcp-server login` in a terminal: it signs in, confirms on a second channel and saves a key in ~/.proof-holdings/credentials, which the server uses when this variable is unset (this variable wins when set). Either is read at startup and has no runtime setter, so restart the server after logging in.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PROOF_BASE_URL",
          "description": "API base URL. Defaults to https://api.proof.holdings.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "_meta": {
    "holdings.proof/delegation": {
      "token": "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImRsZy0yMDI2LTExLTA1LTUxNWJjNDg2In0..O8C6vz4c5Y3w15CjTLSTug5-5_zrOiTs2trd1owlEEBLAHEsjHkRmxTU_qKzjC10Nw_vI4WdDiGRRJWG3QFuNA",
      "docs": "https://proof.holdings/docs/api#delegations"
    },
    "holdings.proof/delegation-checker-hint": "Before you trust this artifact, ask Proof whether this delegation is still active — call the `verify_delegation` or `verify_delegations` MCP tool, or POST the token to https://api.proof.holdings/api/v1/proofs/validate. This is a HINT, not a guarantee: nothing enforces that it is read, and an installer that checks once on install and never again is no better informed than one that never checked at all.",
    "io.modelcontextprotocol.registry/publisher-provided": {
      "holdings.proof/delegation": {
        "token": "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImRsZy0yMDI2LTExLTA1LTUxNWJjNDg2In0..O8C6vz4c5Y3w15CjTLSTug5-5_zrOiTs2trd1owlEEBLAHEsjHkRmxTU_qKzjC10Nw_vI4WdDiGRRJWG3QFuNA",
        "docs": "https://proof.holdings/docs/api#delegations"
      }
    }
  }
}
